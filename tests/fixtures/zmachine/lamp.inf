! Inkventure fixture game: "The Lamp at Saltmere".
! A tiny Z-machine game written for Inkventure's tests and demo (MIT, like the app).
! Built with Inform 6.41 and the Inform 6 standard library 6.12 (distributed under the traditional Inform licence:
! compiled games may be distributed freely). Rebuild with scripts/fixtures/build-z.sh.
!
! It exercises: a "press any key" char prompt, the status line (location, score, turns), line input, several rooms,
! objects, a locked container, a score and a winning ending; single-key prompts naming their keys: HELP ("Choose 1 or
! 2.") and LOGBOOK ("Press Q to quit the menu.", any other key turns a page); a status window of three rows inside the
! shed (region and exits, a progress counter), one row elsewhere; MENU, a menu like the Inform library's: it clears the
! main window at each key, with its legend in a three-row status window (N / P move, Return opens a topic, Q quits);
! questions answered with a line: BOAT asks a yes/no question (the library's YesOrNo) and SIGNAL offers three
! numbered options ("1. Wave the lantern" …), read as a line like a conversation menu.
! GUIDE, a menu drawn in the upper window like Lost Pig's HELP (a centred title, a legend in two columns, three
! subjects with "> " on the selected one; N / P move, Return opens a subject, Q resumes the game).
! TIPS names commands in capitals ("Type WAKE UP … or LOGBOOK …"); the library answers WAKE UP.
! Parser questions: two oilskins at the foot of the tower share a word, so EXAMINE alone there asks "What do you want
! to examine?" and EXAMINE OILSKIN asks "Which do you mean, the yellow oilskin or the black oilskin?". OPEN alone asks
! in words of its own ("Open what, exactly?"), which no phrase table knows.
!
! Walkthrough: (any key) / look / take can / north / open shed / take matches / up / fill lamp / light lamp

Constant Story "THE LAMP AT SALTMERE";
Constant Headline "^An Inkventure test fixture.^";
Constant MAX_SCORE 3;

Replace DrawStatusLine;

Include "Parser";
Include "VerbLib";

[ Initialise;
    location = Landing;
    print "^^[Press any key to begin.]^";
    KeyPress();
    print "^The last boat has gone. The keeper has not come back, and night is falling on Saltmere. Someone has to light
        the lamp.^^";
];

[ KeyPress key;
    @read_char 1 -> key;
    return key;
];

Object Landing "Landing Stage"
  with description
        "A stone jetty at the foot of the lighthouse. The tower door stands open to the north; a wooden shed leans
        against the rocks to the east.",
       n_to Tower, in_to Tower, e_to Shed_Door,
  has  light;

Object -> Can "paraffin can"
  with name 'paraffin' 'can' 'oil' 'fuel',
       description "A dented can, about a quarter full of paraffin.",
       after [;
           Take: if (self hasnt general) { give self general; score++; }
       ];

Object Shed_Door "shed"
  with name 'shed' 'wooden' 'door',
       description "A wooden shed with a rope looped round its door.",
       door_to Shed, door_dir e_to,
       before [;
           Enter: if (self has open) { PlayerTo(Shed); rtrue; }
       ],
       found_in Landing Shed,
  has  scenery door openable ~open;

Object Shed "Inside the Shed"
  with description "Coils of rope, lobster pots and a shelf of odds and ends. The jetty is back to the west.",
       w_to Landing, out_to Landing,
  has  light;

Object -> Matches "box of matches"
  with name 'box' 'of' 'matches' 'match',
       description "A small box of matches, dry enough.";

Object Tower "Foot of the Tower"
  with description
        "A round whitewashed room. Iron stairs spiral up into the dark; the jetty is back to the south. A
        yellow oilskin and a black oilskin hang by the door.",
       s_to Landing, out_to Landing, u_to Lamp_Room,
  has  light;

Object -> Yellow_Oilskin "yellow oilskin"
  with name 'yellow' 'oilskin' 'coat',
       description "A yellow oilskin, stiff with salt.",
  has  scenery;

Object -> Black_Oilskin "black oilskin"
  with name 'black' 'oilskin' 'coat',
       description "The keeper's black oilskin. Its pockets are empty.",
  has  scenery;

Object Lamp_Room "Lamp Room"
  with description
        "The top of the tower, walled with glass. The great lens stands in the middle of the room, and the lamp sits
        under it. The stairs lead back down.",
       d_to Tower,
  has  light;

Object -> Lamp "lamp"
  with name 'lamp' 'burner' 'wick',
       description [;
           if (self has on) "The lamp burns white and steady under the lens.";
           if (self has general) "The lamp is full of paraffin, ready to be lit.";
           "The lamp's reservoir is dry.";
       ],
       before [;
           Fill:
               if (self has general) "It is already full.";
               if (Can notin player) "You have nothing to fill it with.";
               give self general; score++;
               "You pour the paraffin into the reservoir.";
           SwitchOn, Burn:
               if (self hasnt general) "The reservoir is dry: there is nothing to burn.";
               if (Matches notin player) "You have nothing to light it with.";
               give self on; score++;
               deadflag = 2;
               "You strike a match and hold it to the wick. The flame catches, the lens begins to turn, and the beam
               sweeps out over the sea.";
       ],
  has  static switchable;

Object -> Lens "lens"
  with name 'lens' 'glass' 'prisms',
       description "Rings of glass and brass, taller than you are.",
  has  scenery;

Include "Grammar";

! The library's status line (location, score, moves), plus two rows inside the shed, like the regions, compasses and
! progress counters of larger games.
[ DrawStatusLine width rows;
    if (location == nothing || parent(player) == nothing) return;
    rows = 1;
    if (location == Shed) rows = 3;
    StatusLineHeight(rows);
    width = ScreenWidth();
    MoveCursor(1, 1); spaces width;
    if (rows == 3) {
        MoveCursor(2, 1); spaces width;
        MoveCursor(3, 1); spaces width;
    }
    MoveCursor(1, 2); print (name) location;
    MoveCursor(1, width - 26); print (string) SCORE__TX, sline1;
    MoveCursor(1, width - 13); print (string) MOVES__TX, sline2;
    if (rows == 3) {
        MoveCursor(2, 2); print "Saltmere Rock";
        MoveCursor(2, width - 13); print "W  OUT";
        MoveCursor(3, 2); print "Sheds searched: 1/1";
    }
    MainWindow();
];

[ HelpSub key;
    print "Choose 1 or 2.^";
    for (::) {
        key = KeyPress();
        if (key == '1') "Hint: the lamp needs paraffin, and a flame.";
        if (key == '2') "Credits: written for Inkventure's tests.";
    }
];

[ LogbookSub key;
    print "The keeper's logbook. Press Q to quit the menu.^";
    for (::) {
        key = KeyPress();
        if (key == 'q' or 'Q') "You close the logbook.";
        print "You turn a page (", (char) key, ").^";
    }
];

! A menu drawn like the Inform library's DoMenu: the main window is cleared and the menu drawn again after each key.
Array topics --> "About the lamp" "About the keeper";

[ MenuLegend;
    @erase_window 1;
    StatusLineHeight(3);
    @set_window 1;
    MoveCursor(1, 2); print "Saltmere help";
    MoveCursor(2, 2); print "N = Next"; MoveCursor(2, 40); print "Q = Quit Menu";
    MoveCursor(3, 2); print "P = Previous"; MoveCursor(3, 40); print "ENTER = Select";
    MainWindow();
];

[ MenuSub cursor i key;
    cursor = 0;
    for (::) {
        @erase_window 0;
        MenuLegend();
        print "^";
        for (i = 0 : i < 2 : i++) {
            if (i == cursor) print "> "; else print "  ";
            print (string) topics-->i, "^";
        }
        key = KeyPress();
        if (key == 'q' or 'Q') break;
        if (key == 'n' or 'N') cursor = (cursor + 1) % 2;
        if (key == 'p' or 'P') cursor = (cursor + 1) % 2;
        if (key == 13 or 10) {
            @erase_window 0;
            MenuLegend();
            if (cursor == 0) print "^The lamp burns paraffin. Fill it before you light it.^";
            else print "^The keeper rowed out at dawn and has not come back.^";
            print "^[Press any key.]^";
            KeyPress();
        }
    }
    @erase_window 0;
    StatusLineHeight(1);
    DrawStatusLine();
    "You put the menu away.";
];

Verb meta 'menu' * -> Menu;

! GUIDE: a menu drawn in the upper window, like Lost Pig's HELP (the Inform menu library's style): the main window is
! cleared, the upper window holds a centred title, a legend in two columns and the subjects, the selected one marked
! "> ", and it is drawn again after each key. Return opens a subject in the main window; Q closes the guide.
Array subjects --> "The lamp" "The keeper" "The boat";

[ GuideSubject n;
    switch (n) {
        0: print "The lamp burns paraffin. Fill it, then light it with a match.";
        1: print "The keeper rowed out at dawn and has not come back.";
        2: print "The last boat has gone for the night.";
    }
];

[ GuideDraw cursor width i;
    width = ScreenWidth();
    @erase_window 1;
    StatusLineHeight(8);
    @set_window 1;
    for (i = 1 : i <= 8 : i++) { MoveCursor(i, 1); spaces width; }
    MoveCursor(1, (width - 14) / 2 + 1); print "Saltmere guide";
    MoveCursor(2, 2); print "N = next subject"; MoveCursor(2, width - 13); print "P = previous";
    MoveCursor(3, 2); print "RETURN = read subject"; MoveCursor(3, width - 16); print "Q = resume game";
    for (i = 0 : i < 3 : i++) {
        if (i == cursor) { MoveCursor(6 + i, 3); print "> "; }
        else MoveCursor(6 + i, 5);
        print (string) subjects-->i;
    }
    MainWindow();
];

[ GuideSub cursor key;
    cursor = 0;
    for (::) {
        @erase_window 0;
        GuideDraw(cursor);
        key = KeyPress();
        if (key == 'q' or 'Q') break;
        if (key == 'n' or 'N') cursor = (cursor + 1) % 3;
        if (key == 'p' or 'P') cursor = (cursor + 2) % 3;
        if (key == 13 or 10) {
            @erase_window 0;
            StatusLineHeight(1);
            @set_window 1;
            MoveCursor(1, 1); spaces ScreenWidth();
            MoveCursor(1, 2); print (string) subjects-->cursor;
            MainWindow();
            print "^"; GuideSubject(cursor); print "^^[SPACE.]^";
            KeyPress();
        }
    }
    @erase_window 0;
    StatusLineHeight(1);
    DrawStatusLine();
    "You close the guide.";
];

Verb meta 'guide' * -> Guide;

[ BoatSub;
    print "Do you want to call the boat back? ";
    if (YesOrNo()) "You shout, but the boat is too far away to hear you.";
    "You let the boat go.";
];

[ SignalSub key;
    print "How will you signal the ships?^";
    print "1. Wave the lantern^2. Ring the bell^3. Light a flare^";
    for (::) {
        print "^> ";
        KeyboardPrimitive(buffer2, parse2);
        key = buffer2->2;
        if (key == '1') "You wave the lantern, but its light is too weak.";
        if (key == '2') "The bell rings out over the water.";
        if (key == '3') "You have no flare.";
        print "Please choose 1, 2 or 3.";
    }
];

[ TipsSub;
    "Type WAKE UP if you feel sleepy, or LOGBOOK to read the keeper's log.";
];

! A question for a missing object in words of its own, like a game that replaces the library's messages.
[ OpenWhatSub;
    "Open what, exactly?";
];

Verb meta 'tips' * -> Tips;
Extend 'open' first * -> OpenWhat;
Verb 'boat' * -> Boat;
Verb 'signal' * -> Signal;
Verb meta 'help' 'hint' 'hints' * -> Help;
Verb meta 'logbook' 'log' * -> Logbook;
