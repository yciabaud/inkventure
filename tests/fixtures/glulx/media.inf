! "Media": a tiny Glulx test story for Inkventure (MIT). No library: raw Glk calls, like games that use graphics and
! sound without checking what the interpreter supports. It opens a graphics window and draws into it, then plays a
! sound on the channel it was given (none: Inkventure has no sound), and waits for a line.
! Rebuild with scripts/fixtures/build-glulx.sh.

Include "infglk";

Array linebuf -> 64;
Array event --> 4;

[ Main mainwin gwin chan;
  @setiosys 2 0; ! print through Glk (the library does this)
  mainwin = glk_window_open(0, 0, 0, wintype_TextBuffer, 0);
  glk_set_window(mainwin);
  gwin = glk_window_open(mainwin, winmethod_Above + winmethod_Fixed, 10, wintype_Graphics, 0);
  glk_window_set_background_color(gwin, $FFFFFF);
  glk_window_clear(gwin);
  glk_window_fill_rect(gwin, 0, 0, 0, 10, 10);
  glk_image_draw(gwin, 1, 0, 0);
  chan = glk_schannel_create(0);
  glk_schannel_set_volume(chan, $10000);
  glk_schannel_play_ext(chan, 3, 1, 0);
  print "Pictures and sounds are ready.^";
  glk_request_line_event(mainwin, linebuf, 64, 0);
  glk_select(event);
  glk_schannel_stop(chan);
  glk_window_close(gwin, 0);
  print "The end.^";
];
