node_modules/
dist/
coverage/
playwright-report/
test-results/
*.log
.DS_Store

# Catalogue pipeline output and record cache (scripts/catalog)
data/

# Quixe, downloaded at install from its upstream tag (scripts/build/fetch-quixe.ts)
vendor/quixe/*.js

# Decker's runtime and tour deck, downloaded at install from its upstream tag (scripts/build/fetch-decker.ts)
vendor/decker/*.js
vendor/decker/*.deck

# Twine story formats, downloaded at install, and the test fixtures built with them (scripts/fixtures/build-twine.ts)
vendor/twine/
tests/fixtures/twine/*.html
tests/fixtures/twine/*.zip

# The zipped ink web export of the sample catalogue, built at install (scripts/fixtures/build-ink-export.ts)
tests/fixtures/ink/*.zip

# Ebook build output (scripts/ebook/build.ts)
ebook/build/
# Bitsy's engine, font and default game, downloaded at install from a pinned commit (scripts/build/fetch-bitsy.ts)
vendor/bitsy/*.js
vendor/bitsy/*.bitsy
vendor/bitsy/*.bitsyfont
