{
  "name": "inkventure",
  "version": "0.0.0",
  "private": true,
  "description": "Play IFDB interactive fiction on e-readers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/build/fetch-quixe.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && stylelint \"src/**/*.css\" && prettier --check .",
    "format": "prettier --write .",
    "check:es5": "es-check es5 \"dist/assets/*-legacy*.js\" \"dist/probe/*.js\"",
    "check:size": "node scripts/size/check-size.ts",
    "catalog:crawl": "node scripts/catalog/crawl.ts",
    "catalog:resolve": "node scripts/catalog/resolve.ts",
    "catalog:cors": "node scripts/catalog/check-cors.ts",
    "catalog:emit": "node scripts/catalog/emit.ts",
    "catalog:sample": "node scripts/catalog/build-sample.ts",
    "catalog:featured": "node scripts/catalog/build-featured.ts"
  },
  "dependencies": {
    "@fontsource/literata": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "fflate": "^0.8.3",
    "glkote-term": "0.4.4",
    "ifvms": "1.1.6",
    "inkjs": "2.4.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-legacy": "^7.2.1",
    "autoprefixer": "^10.6.1",
    "es-check": "^9.8.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "browserslist": [
    "defaults",
    "safari >= 5",
    "ie >= 11"
  ]
}
