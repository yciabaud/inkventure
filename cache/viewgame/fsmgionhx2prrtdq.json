{"tuid":"fsmgionhx2prrtdq","pageVersion":4,"fetchedAt":"2026-09-30T09:55:56.751Z","record":{"colophon":{"generator":"ifdb.org/viewgame","generatorversion":1,"originated":"2024-05-23"},"identification":{"ifids":["469F64B0-F6AB-4E49-AB4F-92F3C410A9E1"]},"bibliographic":{"title":"Kitty and the Sea","author":"Felix Pleșoianu","language":"en","firstpublished":"2019-12-20","genre":"Surreal","description":"Take two old areas from a text-based virtual world. Stitch them together with new content; flesh out and brush up the old. Add a handful of minimal, abstract illustrations for good measure. \n<p> \nThe result is <i>Kitty and the Sea</i>, a hypertext walking simulator about loneliness; a short story where nothing happens because the good days are past. \n<p> \nIt&#039;s a surreal, dream-like piece, with a touch of steampunk for good measure. Feel free to find your own meanings in it. Every little bit has deep roots however, and carries precious memories. Hopefully that comes through.</p></p>"},"contacts":{"url":"https://felix.plesoianu.ro/intfic/kitty-and-the-sea/"},"ifdb":{"tuid":"fsmgionhx2prrtdq","pageversion":4,"link":"https://ifdb.org/viewgame?id=fsmgionhx2prrtdq","coverart":{"url":"https://ifdb.org/coverart?id=fsmgionhx2prrtdq&version=4"},"primaryPlayOnlineUrl":"https://felix.plesoianu.ro/intfic/kitty-and-the-sea/kitty-and-the-sea.html","downloads":{"links":[{"url":"https://felix.plesoianu.ro/intfic/kitty-and-the-sea/kitty-and-the-sea.html","playOnlineUrl":"https://felix.plesoianu.ro/intfic/kitty-and-the-sea/kitty-and-the-sea.html","title":"Story file","isGame":true,"format":"hypertextgame"},{"url":"https://felix.plesoianu.ro/intfic/kitty-and-the-sea/kitty-and-the-sea.twee","title":"Twee source code","format":"document"}]},"averageRating":5,"starRating":5,"ratingCountAvg":1,"ratingCountTot":1,"tags":[{"name":"beach","tagcnt":1,"gamecnt":32},{"name":"cat","tagcnt":1,"gamecnt":136},{"name":"cats","tagcnt":2,"gamecnt":118},{"name":"choice-based","tagcnt":1,"gamecnt":11